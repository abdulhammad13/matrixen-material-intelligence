# Copy to .env for local development. Do not commit real credentials.
APP_ENV=development
LOG_LEVEL=INFO

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING_MODE=false
SOVEREIGN_MODE=true
NUMMF_EMBEDDING_BACKEND=lexical
NUMMF_EMBEDDING_MODEL=intfloat/multilingual-e5-small
NUMMF_EMBEDDING_DEVICE=cpu
NUMMF_DATABASE_URL=sqlite:///data/processed/nummf.db
NUMMF_AUDIT_PATH=data/processed/audit_events.jsonl
REDIS_URL=
SCRAPE_DO_API_KEY=
